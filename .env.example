# SmartCapex LLM/API configuration (example only)

# Shared API auth
LLM_API_KEY=your-llm-api-key

# Agent endpoints
USER_INTENTS_DECOMPOSER_URL=https://api.example.com/user-intents-decomposer
BI_TRANSLATOR_URL=https://api.example.com/bi-translator
BI_ORCHESTRATOR_URL=https://api.example.com/bi-orchestrator
