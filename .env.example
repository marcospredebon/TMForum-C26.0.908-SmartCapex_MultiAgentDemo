# Model placeholders
DECOMPOSER_MODEL_NAME=provider/model-decomposer-placeholder
BI_TRANSLATOR_MODEL_NAME=provider/model-bi-translator-placeholder
BI_ORCHESTRATOR_MODEL_NAME=provider/model-bi-orchestrator-placeholder
PLANNING_MODEL_NAME=provider/model-planning-placeholder
